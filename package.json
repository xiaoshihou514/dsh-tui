{
  "name": "dsh-tui",
  "version": "0.1.0",
  "description": "An interactive terminal surface for DeepSeek Harness",
  "keywords": [
    "deepseek",
    "terminal",
    "tui",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoshihou514/dsh-tui.git"
  },
  "bugs": "https://github.com/xiaoshihou514/dsh-tui/issues",
  "homepage": "https://github.com/xiaoshihou514/dsh-tui#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint:package": "publint --strict --pack=false",
    "test": "vitest run",
    "prepublishOnly": "pnpm run check && pnpm test && pnpm run build && pnpm run lint:package",
    "prepare": "pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@11.19.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0",
    "ink": "^6.3.1",
    "ink-text-input": "^6.0.0",
    "marked": "^18.0.9",
    "react": "^19.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-stats": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-attachment": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-stats": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session-title": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.5",
    "@types/node": "^22.20.0",
    "@types/react": "^19.1.10",
    "ink-testing-library": "^4.0.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
